#!/usr/bin/env bash
#
# Install the pinned shellcheck, actionlint and jq into a directory, each
# checked against its sha256, for tests/run.sh.
#
#   scripts/install-test-tools DIR
#
# ⛔ The versions and checksums are written here. Each checksum was read on
# 2026-10-13 from the release's own checksum list and from GitHub's asset
# digest, and the two agreed.
#
# Exit status: 0 all installed, 1 could not.
set -euo pipefail

SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256_X86_64=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
SHELLCHECK_SHA256_AARCH64=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588

ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256_AMD64=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ACTIONLINT_SHA256_ARM64=325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6

JQ_VERSION=1.8.2
JQ_SHA256_AMD64=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f
JQ_SHA256_ARM64=8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309

die() {
  echo "install-test-tools: $1" >&2
  shift
  while [ "$#" -gt 0 ]; do
    echo "  $1" >&2
    shift
  done
  exit 1
}

dest="${1:-}"
[ -n "$dest" ] || die "usage: scripts/install-test-tools DIR"

case "$(uname -m)" in
  x86_64)
    sc_arch=x86_64 sc_sum="$SHELLCHECK_SHA256_X86_64"
    al_arch=amd64 al_sum="$ACTIONLINT_SHA256_AMD64"
    jq_arch=amd64 jq_sum="$JQ_SHA256_AMD64"
    ;;
  aarch64 | arm64)
    sc_arch=aarch64 sc_sum="$SHELLCHECK_SHA256_AARCH64"
    al_arch=arm64 al_sum="$ACTIONLINT_SHA256_ARM64"
    jq_arch=arm64 jq_sum="$JQ_SHA256_ARM64"
    ;;
  *) die "no pinned test tools for $(uname -m)" ;;
esac

mkdir -p "$dest"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# fetch URL FILE SHA256
fetch() {
  local rc=0 got
  curl -q --fail --location --silent --show-error --connect-timeout 20 --max-time 300 \
    --retry 3 --retry-connrefused --retry-delay 2 --output "$2" "$1" || rc=$?
  [ "$rc" -eq 0 ] || die "could not download $1 (curl $rc)" "reproduce: curl -fLO $1"
  got="$(sha256sum "$2" | cut -d ' ' -f 1)"
  [ "$got" = "$3" ] || die "$(basename "$2") has sha256 $got, pinned $3" "reproduce: curl -fsSL $1 | sha256sum"
}

fetch "https://github.com/koalaman/shellcheck/releases/download/v$SHELLCHECK_VERSION/shellcheck-v$SHELLCHECK_VERSION.linux.$sc_arch.tar.xz" \
  "$work/shellcheck.tar.xz" "$sc_sum"
tar -xJf "$work/shellcheck.tar.xz" -C "$work"
install -m 0755 "$work/shellcheck-v$SHELLCHECK_VERSION/shellcheck" "$dest/shellcheck"

fetch "https://github.com/rhysd/actionlint/releases/download/v$ACTIONLINT_VERSION/actionlint_${ACTIONLINT_VERSION}_linux_$al_arch.tar.gz" \
  "$work/actionlint.tar.gz" "$al_sum"
tar -xzf "$work/actionlint.tar.gz" -C "$work" actionlint
install -m 0755 "$work/actionlint" "$dest/actionlint"

fetch "https://github.com/jqlang/jq/releases/download/jq-$JQ_VERSION/jq-linux-$jq_arch" "$work/jq" "$jq_sum"
install -m 0755 "$work/jq" "$dest/jq"

"$dest/shellcheck" --version | awk '/^version:/ { print "shellcheck " $2 }'
"$dest/actionlint" -version | awk 'NR == 1 { print "actionlint " $1 }'
"$dest/jq" --version
